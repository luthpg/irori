{
  "name": "irori",
  "version": "0.1.0",
  "description": "Lifestyle-stance chat app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "cf-typegen": "wrangler types --include-runtime=false",
    "typecheck": "wrangler types --include-runtime=false && react-router typegen && tsc --noEmit",
    "seed:test-space": "node --experimental-strip-types scripts/seed-test-space.ts",
    "test": "vitest run",
    "check": "biome check --write",
    "check:ci": "biome check .",
    "check:knowledge": "tsx scripts/ai-knowledge/check-knowledge-refs.ts",
    "check:doc-sync": "tsx scripts/ai-knowledge/check-doc-sync.ts",
    "verify": "pnpm run typecheck && pnpm run check:ci && pnpm run check:knowledge && pnpm run check:doc-sync && pnpm run test && pnpm run build",
    "deploy": "pnpm run build && wrangler deploy"
  },
  "dependencies": {
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "isbot": "^5.2.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@cloudflare/vite-plugin": "^1.68.0",
    "@cloudflare/workers-types": "^5.20261110.1",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@10.32.1"
}
